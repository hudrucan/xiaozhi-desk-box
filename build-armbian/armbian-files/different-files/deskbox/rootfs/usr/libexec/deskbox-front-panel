#!/usr/bin/env python3
"""Drive the Desk Box FD6551 clock and connectivity indicators."""

import fcntl
import glob
import os
import signal
import subprocess
import sys
import time
from datetime import datetime


CLK_PIN = 131  # RK3528 GPIO4_A3
DAT_PIN = 130  # RK3528 GPIO4_A2
GPIO_PATH = "/sys/class/gpio/gpio{pin}"
LOCK_PATH = "/run/lock/deskbox-front-panel.lock"

MODE_ADDR = 0x48
ICON_ADDR = 0x66
DIGIT_ADDRS = (0x68, 0x6A, 0x6C, 0x6E)
HALF_CLOCK = 0.000005
TIME_QUERY_INTERVAL = 5.0
GPIO_FDS = {}

DIGITS = {
    "0": 0x3F,
    "1": 0x06,
    "2": 0x5B,
    "3": 0x4F,
    "4": 0x66,
    "5": 0x6D,
    "6": 0x7D,
    "7": 0x07,
    "8": 0x7F,
    "9": 0x6F,
}

# Hardware-verified on the Desk Box front panel.
ICON_CLOCK = 0x01
ICON_USB = 0x02
ICON_PAUSE = 0x04
ICON_PLAY = 0x08
ICON_COLON = 0x10
ICON_LAN = 0x20
ICON_WIFI = 0x40
DASH = 0x40
BOOT_SEGMENTS = (0x7C, 0x5C, 0x5C, 0x78)


def write_text(path, value):
    with open(path, "w", encoding="ascii") as stream:
        stream.write(str(value))


def export_pin(pin):
    path = GPIO_PATH.format(pin=pin)
    if not os.path.isdir(path):
        write_text("/sys/class/gpio/export", pin)
        for _ in range(100):
            if os.path.isdir(path):
                break
            time.sleep(0.001)
        else:
            raise RuntimeError(f"gpio{pin} did not appear after export")
    write_text(path + "/direction", "out")
    GPIO_FDS[pin] = os.open(path + "/value", os.O_WRONLY | os.O_CLOEXEC)


def set_gpio(pin, value):
    descriptor = GPIO_FDS[pin]
    os.lseek(descriptor, 0, os.SEEK_SET)
    os.write(descriptor, b"1" if value else b"0")


def clk(value):
    set_gpio(CLK_PIN, value)


def dat(value):
    set_gpio(DAT_PIN, value)


def start():
    dat(1)
    clk(1)
    time.sleep(HALF_CLOCK)
    dat(0)
    time.sleep(HALF_CLOCK)
    clk(0)
    time.sleep(HALF_CLOCK)


def stop():
    dat(0)
    clk(0)
    time.sleep(HALF_CLOCK)
    clk(1)
    time.sleep(HALF_CLOCK)
    dat(1)
    time.sleep(HALF_CLOCK)


def write_byte(value):
    for bit in range(7, -1, -1):
        dat((value >> bit) & 1)
        time.sleep(HALF_CLOCK)
        clk(1)
        time.sleep(HALF_CLOCK)
        clk(0)
        time.sleep(HALF_CLOCK)
    dat(1)
    time.sleep(HALF_CLOCK)
    clk(1)
    time.sleep(HALF_CLOCK)
    clk(0)
    time.sleep(HALF_CLOCK)


def write_register(address, value):
    start()
    write_byte(address)
    write_byte(value)
    stop()


def initialize():
    export_pin(CLK_PIN)
    export_pin(DAT_PIN)
    clk(0)
    dat(1)
    # Exact seller sequence verified on the reference Desk Box.
    write_register(MODE_ADDR, 0x01)
    write_register(MODE_ADDR, 0x03)
    time.sleep(0.05)


def read_text(path):
    try:
        with open(path, "r", encoding="ascii") as stream:
            return stream.read().strip()
    except OSError:
        return ""


def carrier(interface):
    return read_text(f"/sys/class/net/{interface}/carrier") == "1"


def external_usb_present():
    for path in glob.glob("/sys/bus/usb/devices/*"):
        name = os.path.basename(path)
        if name.startswith("usb") or ":" in name:
            continue
        if os.path.isfile(os.path.join(path, "idVendor")):
            if read_text(os.path.join(path, "bDeviceClass")) != "09":
                return True
    return False


def time_is_trustworthy():
    try:
        result = subprocess.run(
            ["/usr/bin/chronyc", "tracking"],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
            env={**os.environ, "LC_ALL": "C"},
        )
    except (OSError, subprocess.SubprocessError):
        return False
    if result.returncode != 0:
        return False

    fields = {}
    for line in result.stdout.splitlines():
        if ":" in line:
            name, value = line.split(":", 1)
            fields[name.strip()] = value.strip()

    try:
        stratum = int(fields.get("Stratum", "0"))
    except ValueError:
        return False
    reference = fields.get("Reference ID", "").split(maxsplit=1)[0]
    return (
        stratum > 0
        and reference not in {"", "00000000", "0.0.0.0"}
        and fields.get("Leap status") == "Normal"
    )


def connectivity_icons(now, trusted_time):
    mask = ICON_COLON if trusted_time and now.second % 2 == 0 else 0
    if carrier("wlan0"):
        mask |= ICON_WIFI
    if carrier("end0"):
        mask |= ICON_LAN
    if external_usb_present():
        mask |= ICON_USB
    return mask


def main():
    if os.geteuid() != 0:
        raise SystemExit("deskbox-front-panel must run as root")
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] != "--placeholder"):
        raise SystemExit("usage: deskbox-front-panel [--placeholder]")
    placeholder_only = len(sys.argv) == 2

    stopping = False

    def request_stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True)
    with open(LOCK_PATH, "w", encoding="ascii") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        initialize()
        if placeholder_only:
            for address, value in zip(DIGIT_ADDRS, BOOT_SEGMENTS):
                write_register(address, value)
            write_register(ICON_ADDR, 0)
            return

        trusted_time = False
        next_time_query = 0.0
        previous_segments = None
        previous_icons = None

        while not stopping:
            monotonic_now = time.monotonic()
            if not trusted_time and monotonic_now >= next_time_query:
                trusted_time = time_is_trustworthy()
                next_time_query = monotonic_now + TIME_QUERY_INTERVAL

            now = datetime.now()
            if trusted_time:
                segments = tuple(DIGITS[value] for value in f"{now.hour:02d}{now.minute:02d}")
            else:
                segments = (DASH,) * len(DIGIT_ADDRS)
            icons = connectivity_icons(now, trusted_time)

            if segments != previous_segments:
                for address, value in zip(DIGIT_ADDRS, segments):
                    write_register(address, value)
                previous_segments = segments
            if icons != previous_icons:
                write_register(ICON_ADDR, icons)
                previous_icons = icons
            time.sleep(0.2)


if __name__ == "__main__":
    main()
