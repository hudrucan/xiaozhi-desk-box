[Unit]
Description=Desk Box FD6551 front-panel clock
Wants=chrony.service deskbox-front-panel-early.service
After=chrony.service deskbox-front-panel-early.service

[Service]
Type=simple
ExecStart=/usr/libexec/deskbox-front-panel
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
